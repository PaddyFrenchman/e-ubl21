{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaddyFrenchman/e-ubl21/regression/schemas/normalized-result.schema.json",
  "title": "e-ubl21 normalized regression result",
  "description": "One deterministic semantic result line for results.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "sha256",
    "profile",
    "expectedFinal",
    "actualFinal",
    "expectedStages",
    "actualStages",
    "result"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "fixtureId": {"$ref": "#/$defs/fixtureId"},
    "sha256": {"$ref": "#/$defs/sha256"},
    "profile": {"$ref": "#/$defs/profile"},
    "expectedFinal": {"enum": ["valid", "invalid"]},
    "actualFinal": {"enum": ["valid", "invalid", "operational-failure"]},
    "expectedStages": {"type": "array"},
    "actualStages": {"type": "array"},
    "result": {"enum": ["pass", "fail"]}
  },
  "allOf": [
    {
      "if": {"properties": {"expectedFinal": {"const": "valid"}}, "required": ["expectedFinal"]},
      "then": {
        "properties": {
          "expectedStages": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/expectedStage"},
                {"properties": {"outcome": {"const": "passed"}}}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "expectedStages": {
            "contains": {"properties": {"outcome": {"const": "standards-invalid"}}, "required": ["outcome"]},
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {"$ref": "#/$defs/ubl21Sequence"},
    {"$ref": "#/$defs/en16931Sequence"},
    {"$ref": "#/$defs/peppolSequence"}
  ],
  "$defs": {
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "enum": ["ubl21", "ubl21-en16931", "peppol-bis-billing"]
    },
    "stageName": {
      "enum": ["ubl21-xsd", "en16931", "peppol-bis-billing"]
    },
    "ruleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "expectedStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "outcome"],
      "properties": {
        "stage": {"$ref": "#/$defs/stageName"},
        "outcome": {"enum": ["passed", "standards-invalid"]},
        "ruleIds": {"$ref": "#/$defs/ruleIds"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {"enum": ["en16931", "peppol-bis-billing"]},
              "outcome": {"const": "standards-invalid"}
            },
            "required": ["stage", "outcome"]
          },
          "then": {"required": ["ruleIds"]}
        },
        {
          "if": {"properties": {"outcome": {"const": "passed"}}, "required": ["outcome"]},
          "then": {"not": {"required": ["ruleIds"]}}
        }
      ]
    },
    "actualStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "outcome"],
      "properties": {
        "stage": {"$ref": "#/$defs/stageName"},
        "outcome": {"enum": ["passed", "standards-invalid", "operational-failure"]},
        "ruleIds": {"$ref": "#/$defs/ruleIds"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {"enum": ["en16931", "peppol-bis-billing"]},
              "outcome": {"const": "standards-invalid"}
            },
            "required": ["stage", "outcome"]
          },
          "then": {"required": ["ruleIds"]}
        },
        {
          "if": {"properties": {"outcome": {"enum": ["passed", "operational-failure"]}}, "required": ["outcome"]},
          "then": {"not": {"required": ["ruleIds"]}}
        }
      ]
    },
    "expectedUBL21": {
      "allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "ubl21-xsd"}}}]
    },
    "expectedEN16931": {
      "allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "en16931"}}}]
    },
    "expectedPeppol": {
      "allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "peppol-bis-billing"}}}]
    },
    "actualUBL21": {
      "allOf": [{"$ref": "#/$defs/actualStage"}, {"properties": {"stage": {"const": "ubl21-xsd"}}}]
    },
    "actualEN16931": {
      "allOf": [{"$ref": "#/$defs/actualStage"}, {"properties": {"stage": {"const": "en16931"}}}]
    },
    "actualPeppol": {
      "allOf": [{"$ref": "#/$defs/actualStage"}, {"properties": {"stage": {"const": "peppol-bis-billing"}}}]
    },
    "ubl21Sequence": {
      "if": {"properties": {"profile": {"const": "ubl21"}}, "required": ["profile"]},
      "then": {
        "properties": {
          "expectedStages": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [{"$ref": "#/$defs/expectedUBL21"}],
            "items": false
          },
          "actualStages": {
            "minItems": 0,
            "maxItems": 1,
            "prefixItems": [{"$ref": "#/$defs/actualUBL21"}],
            "items": false
          }
        }
      }
    },
    "en16931Sequence": {
      "if": {"properties": {"profile": {"const": "ubl21-en16931"}}, "required": ["profile"]},
      "then": {
        "properties": {
          "expectedStages": {
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {"allOf": [{"$ref": "#/$defs/expectedUBL21"}, {"properties": {"outcome": {"const": "passed"}}}]},
              {"$ref": "#/$defs/expectedEN16931"}
            ],
            "items": false
          },
          "actualStages": {
            "minItems": 0,
            "maxItems": 2,
            "prefixItems": [
              {"$ref": "#/$defs/actualUBL21"},
              {"$ref": "#/$defs/actualEN16931"}
            ],
            "items": false
          }
        }
      }
    },
    "peppolSequence": {
      "if": {"properties": {"profile": {"const": "peppol-bis-billing"}}, "required": ["profile"]},
      "then": {
        "properties": {
          "expectedStages": {
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {"allOf": [{"$ref": "#/$defs/expectedUBL21"}, {"properties": {"outcome": {"const": "passed"}}}]},
              {"allOf": [{"$ref": "#/$defs/expectedEN16931"}, {"properties": {"outcome": {"const": "passed"}}}]},
              {"$ref": "#/$defs/expectedPeppol"}
            ],
            "items": false
          },
          "actualStages": {
            "minItems": 0,
            "maxItems": 3,
            "prefixItems": [
              {"$ref": "#/$defs/actualUBL21"},
              {"$ref": "#/$defs/actualEN16931"},
              {"$ref": "#/$defs/actualPeppol"}
            ],
            "items": false
          }
        }
      }
    }
  }
}
