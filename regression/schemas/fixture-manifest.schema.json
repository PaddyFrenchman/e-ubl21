{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaddyFrenchman/e-ubl21/regression/schemas/fixture-manifest.schema.json",
  "title": "e-ubl21 regression fixture manifest",
  "description": "Versioned expectations and provenance for a deterministic regression corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtures"],
  "properties": {
    "schemaVersion": {"const": 1},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fixture"}
    }
  },
  "$defs": {
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "enum": ["ubl21", "ubl21-en16931", "peppol-bis-billing"]
    },
    "stageName": {
      "enum": ["ubl21-xsd", "en16931", "peppol-bis-billing"]
    },
    "ruleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "expectedStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "outcome"],
      "properties": {
        "stage": {"$ref": "#/$defs/stageName"},
        "outcome": {"enum": ["passed", "standards-invalid"]},
        "ruleIds": {"$ref": "#/$defs/ruleIds"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {"enum": ["en16931", "peppol-bis-billing"]},
              "outcome": {"const": "standards-invalid"}
            },
            "required": ["stage", "outcome"]
          },
          "then": {"required": ["ruleIds"]}
        },
        {
          "if": {
            "properties": {"outcome": {"const": "passed"}},
            "required": ["outcome"]
          },
          "then": {"not": {"required": ["ruleIds"]}}
        }
      ]
    },
    "generatedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "generator", "generatorVersion"],
      "properties": {
        "kind": {"const": "generated"},
        "generator": {"type": "string", "minLength": 1},
        "generatorVersion": {"type": "string", "minLength": 1}
      }
    },
    "importedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "publisher", "sourceUrl", "sourceVersion", "sourceSha256", "license"],
      "properties": {
        "kind": {"const": "official-import"},
        "publisher": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "format": "uri"},
        "sourceVersion": {"type": "string", "minLength": 1},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "oneOf": [
        {"$ref": "#/$defs/generatedProvenance"},
        {"$ref": "#/$defs/importedProvenance"}
      ]
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ubl", "en16931", "peppol"],
      "properties": {
        "ubl": {"const": "2.1"},
        "en16931": {"type": ["string", "null"]},
        "peppol": {"type": ["string", "null"]}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "documentType",
        "profile",
        "file",
        "sha256",
        "standards",
        "provenance",
        "expectedFinal",
        "expectedStages",
        "tags"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/fixtureId"},
        "documentType": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "profile": {"$ref": "#/$defs/profile"},
        "file": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.xml$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "standards": {"$ref": "#/$defs/standards"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "expectedFinal": {"enum": ["valid", "invalid"]},
        "expectedStages": {
          "type": "array",
          "items": {"$ref": "#/$defs/expectedStage"}
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"expectedFinal": {"const": "valid"}}, "required": ["expectedFinal"]},
          "then": {
            "properties": {
              "expectedStages": {
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/expectedStage"},
                    {"properties": {"outcome": {"const": "passed"}}}
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "expectedStages": {
                "contains": {"properties": {"outcome": {"const": "standards-invalid"}}, "required": ["outcome"]},
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"profile": {"const": "ubl21"}}, "required": ["profile"]},
          "then": {
            "properties": {
              "standards": {
                "properties": {
                  "en16931": {"const": null},
                  "peppol": {"const": null}
                }
              },
              "expectedStages": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {"allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "ubl21-xsd"}}}]}
                ],
                "items": false
              }
            }
          }
        },
        {
          "if": {"properties": {"profile": {"const": "ubl21-en16931"}}, "required": ["profile"]},
          "then": {
            "properties": {
              "standards": {
                "properties": {
                  "en16931": {"type": "string", "minLength": 1},
                  "peppol": {"const": null}
                }
              },
              "expectedStages": {
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {"allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "ubl21-xsd"}, "outcome": {"const": "passed"}}}]},
                  {"allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "en16931"}}}]}
                ],
                "items": false
              }
            }
          }
        },
        {
          "if": {"properties": {"profile": {"const": "peppol-bis-billing"}}, "required": ["profile"]},
          "then": {
            "properties": {
              "standards": {
                "properties": {
                  "en16931": {"type": "string", "minLength": 1},
                  "peppol": {"type": "string", "minLength": 1}
                }
              },
              "expectedStages": {
                "minItems": 3,
                "maxItems": 3,
                "prefixItems": [
                  {"allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "ubl21-xsd"}, "outcome": {"const": "passed"}}}]},
                  {"allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "en16931"}, "outcome": {"const": "passed"}}}]},
                  {"allOf": [{"$ref": "#/$defs/expectedStage"}, {"properties": {"stage": {"const": "peppol-bis-billing"}}}]}
                ],
                "items": false
              }
            }
          }
        }
      ]
    }
  }
}
